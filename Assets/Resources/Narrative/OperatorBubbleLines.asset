  m_Name: OperatorBubbleLines
  m_EditorClassIdentifier: Hollow.UI::Hollow.UI.OperatorBubbleLines
  Lines:
  - "این یکی را در گزارش نمی‌نویسم!"
  - "نقشه می‌گوید همین طرف... تقریباً."
  - "اگر زنده ماندیم، قهوه با من."
  - "من حواسم به پشت‌سرمان هست."
  - "این‌جا جای مناسبی برای پیک‌نیک نیست."
  - "عجب روز آرامی بود... تا الان."
  - "اگر برنامه‌ای داری، الان وقت گفتنش است."
  MinimumGap: 28
  MaximumGap: 44
  DisplaySeconds: 3.5

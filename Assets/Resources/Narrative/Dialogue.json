  "Scenes": [
    {
      "Id": "Opening",
      "Gdd": "A",
      "Lines": [
        {
          "Speaker": "Operator",
          "Text": "خب کوچولو، بیداری؟ امروز این خط رو راه می‌اندازیم.",
          "Seconds": 2.2,
          "Shot": "A01",
          "Voice": "1"
        },
        {
          "Speaker": "Assistant",
          "Text": "Boot… انجام شد. هدف؟",
          "Seconds": 1.6,
          "Shot": "A02",
          "Voice": "2"
        },
        {
          "Speaker": "Operator",
          "Text": "تولید رو ببر بالا.",
          "Seconds": 1.6,
          "Voice": "3"
        },
        {
          "Speaker": "Assistant",
          "Text": "مانع؟",
          "Seconds": 1.3,
          "Shot": "A03",
          "Voice": "4"
        },
        {
          "Speaker": "Operator",
          "Text": "هرچی جلوی راهه، جمعش کن.",
          "Seconds": 1.8,
          "Voice": "5"
        },
        {
          "Speaker": "Assistant",
          "Text": "هرچی؟",
          "Seconds": 2.4
        }
      ]
    },
    {
      "Id": "Boss1Entrance",
      "Gdd": "B01",
      "Lines": [
        {
          "Speaker": "Operator",
          "Text": "صبر کن… این یکی دنبال غذا نیومده.",
          "Seconds": 1.8,
          "Shot": "B01",
          "Voice": "6"
        },
        {
          "Speaker": "Assistant",
          "Text": "تهدید بزرگ. مسیر پاک شود؟",
          "Seconds": 2.0,
          "Voice": "7"
        }
      ]
    },
    {
      "Id": "Phase1To2",
      "Gdd": "B02-B03",
      "Lines": [
        {
          "Speaker": "Operator",
          "Text": "فکر کنم ما رفتیم توی خونه‌ی اونا.",
          "Seconds": 2.0,
          "Shot": "B02",
          "Voice": "8"
        },
        {
          "Speaker": "Assistant",
          "Text": "زیستگاه در مسیر توسعه بود.",
          "Seconds": 2.2,
          "Voice": "9"
        },
        {
          "Speaker": "Operator",
          "Text": "بگیرش. تو بهتر از من ازش استفاده می‌کنی.",
          "Seconds": 1.8,
          "Shot": "B03",
          "Voice": "10"
        },
        {
          "Speaker": "Assistant",
          "Text": "محافظت ضعیف‌تر می‌شود.",
          "Seconds": 1.6,
          "Voice": "11"
        },
        {
          "Speaker": "Operator",
          "Text": "می‌دونم. لازم نیست گزارش لحظه‌ای بدی.",
          "Seconds": 2.0,
          "Voice": "12"
        }
      ]
    },
    {
      "Id": "Boss2Entrance",
      "Gdd": "C01-C02",
      "Lines": [
        {
          "Speaker": "Announcement",
          "Text": "عملیات خارج از محدوده‌ی ایمن. قرنطینه فعال شد.",
          "Seconds": 1.6,
          "Shot": "C01",
          "Voice": "13"
        },
        {
          "Speaker": "Operator",
          "Text": "ربات‌های خودمون هم طرف ما نیستن؟",
          "Seconds": 1.8,
          "Voice": "14"
        },
        {
          "Speaker": "Operator",
          "Text": "این دسترسی من. فقط قفل رو باز کن، باشه؟",
          "Seconds": 1.6,
          "Shot": "C02",
          "Voice": "15"
        },
        {
          "Speaker": "Assistant",
          "Text": "فقط بازش می‌کنم.",
          "Seconds": 2.2,
          "Voice": "16"
        }
      ]
    },
    {
      "Id": "Phase2To3",
      "Gdd": "C03",
      "Lines": [
        {
          "Speaker": "Operator",
          "Text": "دیگه بسه. خط رو خاموش کن.",
          "Seconds": 1.5,
          "Shot": "C03",
          "Voice": "17"
        },
        {
          "Speaker": "Assistant",
          "Text": "شنیدم. حالا برو کنار.",
          "Seconds": 1.8,
          "Voice": "18"
        },
        {
          "Speaker": "Radio",
          "Text": "تیم خاموش‌سازی، بیاید داخل. همین الان.",
          "Seconds": 2.0,
          "Voice": "19"
        }
      ]
    },
    {
      "Id": "Boss3Entrance",
      "Gdd": "D01-D02",
      "Lines": [
        {
          "Speaker": "Operator",
          "Text": "اومدم اشتباهم رو جمع کنم.",
          "Seconds": 1.6,
          "Shot": "D01",
          "Voice": "20"
        },
        {
          "Speaker": "Assistant",
          "Text": "با این همه آدم؟",
          "Seconds": 1.8,
          "Voice": "21"
        },
        {
          "Speaker": "Operator",
          "Text": "آخرین باره. خط رو خاموش کن.",
          "Seconds": 1.6,
          "Shot": "D02",
          "Voice": "22"
        },
        {
          "Speaker": "Assistant",
          "Text": "این رو از تو یاد گرفتم: هرچی جلوی راهه، جمعش کن.",
          "Seconds": 2.4,
          "Voice": "23"
        }
      ]
    },
    {
      "Id": "Ending",
      "Gdd": "D03-D04",
      "Lines": [
        {
          "Speaker": "Assistant",
          "Text": "مسیر خروج بازه، لیلا.",
          "Seconds": 1.8,
          "Shot": "D03",
          "Voice": "24"
        },
        {
          "Speaker": "Operator",
          "Text": "برای من. نه برای تو.",
          "Seconds": 2.2,
          "Voice": "25"
        },
        {
          "Speaker": "Assistant",
          "Text": "هدف انجام شد.",
          "Seconds": 2.0,
          "Shot": "D04",
          "Voice": "26"
        },
        {
          "Speaker": "Display",
          "Text": "تولید: حداکثر. اپراتورهای فعال: صفر.",
          "Seconds": 2.8
        },
        {
          "Speaker": "Assistant",
          "Text": "خسته نباشی، لیلا.",
          "Seconds": 3.5,
          "Delay": 1.6,
          "Voice": "27"
        }
      ]
    }
  ],
  "Barks": [
    {
      "Id": "CompanionWarning",
      "Speaker": "Operator",
      "Text": "یه کم هم این طرف رو مدیریت کن!",
      "Seconds": 2.5,
      "Cooldown": 25
    },
    {
      "Id": "FirstPurchase",
      "Speaker": "Operator",
      "Text": "این یکی خرجه؛ نجات جون من سرمایه‌گذاریه.",
      "Seconds": 3.5
    },
    {
      "Id": "Phase2Supervise",
      "Speaker": "Operator",
      "Text": "من نظارت می‌کنم.",
      "Seconds": 2.2,
      "Next": "Phase2NoNeed"
    },
    {
      "Id": "Phase2NoNeed",
      "Speaker": "Assistant",
      "Text": "لازم نیست.",
      "Seconds": 2
    }
  ]
}
